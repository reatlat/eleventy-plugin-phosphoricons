<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Liquid Test - 11ty Plugin Phosphor Icons</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="py-14 px-8">
<div class="max-w-3xl mx-auto">
    <h1 class="text-2xl font-bold mb-8">Liquid Template Test</h1>

    <h2 class="text-xl font-semibold mt-8 mb-4">Basic Usage</h2>
    <div class="flex flex-wrap gap-4 items-center">
        <div>
            <p class="text-sm text-gray-500 mb-1">Default:</p>
            {% phicon "heart" %}
        </div>
        <div>
            <p class="text-sm text-gray-500 mb-1">With type:</p>
            {% phicon "heart" "fill" %}
        </div>
        <div>
            <p class="text-sm text-gray-500 mb-1">Duotone:</p>
            {% phicon "heart" "duotone" %}
        </div>
    </div>

    <h2 class="text-xl font-semibold mt-8 mb-4">With Extra Classes</h2>
    <p class="text-sm text-gray-500 mb-4">Liquid syntax: <code>{% raw %}{% phicon "icon" "type" "extra-classes" %}{% endraw %}</code></p>
    <div class="flex flex-wrap gap-4 items-center">
        <div>
            <p class="text-sm text-gray-500 mb-1">Single class:</p>
            {% phicon "star" "fill" "text-yellow-500" %}
        </div>
        <div>
            <p class="text-sm text-gray-500 mb-1">Multiple classes:</p>
            {% phicon "lightning" "fill" "text-orange-500 drop-shadow-lg" %}
        </div>
        <div>
            <p class="text-sm text-gray-500 mb-1">Tailwind hover:</p>
            {% phicon "fire" "fill" "text-red-500 hover:text-red-700 transition-colors cursor-pointer" %}
        </div>
    </div>

    <h2 class="text-xl font-semibold mt-8 mb-4">All Icon Types</h2>
    <div class="flex flex-wrap gap-4 items-center">
        <div class="text-center">
            <p class="text-sm text-gray-500 mb-1">regular</p>
            {% phicon "house" %}
        </div>
        <div class="text-center">
            <p class="text-sm text-gray-500 mb-1">thin</p>
            {% phicon "house" "thin" %}
        </div>
        <div class="text-center">
            <p class="text-sm text-gray-500 mb-1">light</p>
            {% phicon "house" "light" %}
        </div>
        <div class="text-center">
            <p class="text-sm text-gray-500 mb-1">bold</p>
            {% phicon "house" "bold" %}
        </div>
        <div class="text-center">
            <p class="text-sm text-gray-500 mb-1">fill</p>
            {% phicon "house" "fill" %}
        </div>
        <div class="text-center">
            <p class="text-sm text-gray-500 mb-1">duotone</p>
            {% phicon "house" "duotone" %}
        </div>
    </div>

    <hr class="my-8">
    <p class="text-sm text-gray-500">Built with {{ eleventy.generator }}</p>
</div>
</body>
</html>